{
  "monitoring": {
    "enabled_monitors": ["file", "process", "network", "registry"],
    "monitor_folders": [
      "test_folder"
    ],
    "file_monitor": {
      "recursive": true,
      "ignore_patterns": [".git", "__pycache__", "node_modules"]
    },
    "process_monitor": {
      "poll_interval": 2,
      "ignore_system_processes": true
    },
    "network_monitor": {
      "poll_interval": 3,
      "ignore_local_connections": false
    },
    "registry_monitor": {
      "poll_interval": 5,
      "monitor_hives": ["HKEY_LOCAL_MACHINE", "HKEY_CURRENT_USER", "HKEY_CLASSES_ROOT", "HKEY_USERS"]
    }
  },
  "ml": {
    "enabled": true,
    "model_path": "models/practical_xgboost.pkl",
    "scaler_path": "models/practical_scaler.pkl",
    "autoencoder_path": "models/autoencoder_model.keras",
    "classification_threshold": 0.85,
    "anomaly_threshold": 0.541678,
    "aggregation": {
      "window_seconds": 30,
      "min_events": 10
    }
  },
  "alerts": {
    "enabled": true,
    "log_dir": "monitor/logs",
    "console_output": true,
    "critical_threshold": 0.85,
    "warning_threshold": 0.70
  },
  "prevention": {
    "enabled": false,
    "auto_terminate": false,
    "auto_terminate_threshold": "CRITICAL",
    "lock_filesystem": false,
    "disable_network": false,
    "early_warning_detection": true,
    "controlled_folder_access": {
      "enabled": false,
      "protected_folders": [
        "C:\\Users\\Documents",
        "C:\\Users\\Pictures",
        "C:\\Users\\Desktop"
      ]
    }
  },
  "logging": {
    "event_log": "monitor/logs/events.csv",
    "alert_log": "monitor/logs/alerts.csv",
    "alert_json": "monitor/logs/alerts.json"
  }
}
