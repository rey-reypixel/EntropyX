# Runtime logs and raw event extracts - never commit these. They capture
# full process command lines and network connections verbatim from
# whatever is running on the monitored machine at the time, which can
# incidentally include real secrets, tokens, or other sensitive data
# passed on a command line. events.csv is also 1.3GB+. See bugs_debugs.txt
# BUG #13 - a UUID from a captured VS Code command line falsely tripped
# GitHub's OpenVSX secret scanner; the near-miss is why this is now a
# blanket rule instead of excluding files one at a time as they're noticed.
monitor/logs/events.csv
monitor/logs/network_log.csv
monitor/logs/process_log.csv
monitor/logs/alerts.csv
monitor/logs/alerts.json
datasets/new_session_events.csv
datasets/new_session2_events.csv

# Demo-generated throwaway files (recreated by simulate_ransomware_behavior.py --setup)
demo/victim_files/

# Python bytecode cache
__pycache__/
*.pyc

# Project-local virtual environment (Python 3.12 + pandas/sklearn/xgboost/
# tensorflow/joblib/psutil/watchdog/pytest) - recreate with:
#   python -m venv .venv && .venv/Scripts/pip install pandas numpy scikit-learn xgboost tensorflow joblib psutil watchdog pytest
.venv/

# Editor/OS cruft
.DS_Store
Thumbs.db
